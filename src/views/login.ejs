<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <%- include('includes/head') %>
    <style>
        .btn-chat, .btn-ws{
            display: none;
        }
    </style>
    <script>
        async function getData() {
            const url = '/api/auth/login';
            try {
                const response = await fetch(url,{
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        username: document.getElementById("user").value,
                        password: document.getElementById("password").value
                    })
                })
                
                const alert = document.querySelector('.alert')
                if (!response.ok) {
                    console.log(response.status);
                    
                    alert.classList.add('alert-primary')
                    alert.classList.remove('d-none')

                    if (`${response.status}` != '404') {
                        const json = await response.json()
                        alert.innerHTML = json.message
                    }else{
                        alert.innerHTML = 'Error al comunicarser con el servidor!'
                    }
                    throw new Error(`Response status: ${response.status}`)
                }                

                const json = await response.json()
                alert.classList.add('alert-success')
                alert.classList.remove('d-none')
                alert.innerHTML = '¡Bienvenido!'

                console.log(json)
                
            } catch (error) {
                console.error(error.message)
            }
        }
    </script>
</head>

<body class="bg-tertiary">
    <%- include('includes/nav') %>

    <div class="container flex-fill d-flex justify-content-center align-items-center py-5">
        
        <form id="form" class="form-control p-4" style="max-width: 400px;">         
            <h3 class="display-6 fw-normal text-primary text-center mb-0">Iniciar sesión</h3>
            <p class="text-center mb-3 fw-normal text-secondary">Si usted es una operadora de inamujer. Por favor, ingrese sus credenciales.</p>
    
            <div class="alert d-none" role="alert"></div>

            <div class="form-floating mb-3">
                <input required type="text" class="form-control rounded-pill" name="user" id="user" placeholder="Usuario">
                <label class="text-primary" for="user">Usuario</label>
            </div>

            <div class="form-floating">
                <input required type="password" class="form-control rounded-pill" name="password" id="password" placeholder="Contraseña">
                <label class="text-primary" for="password">Contraseña</label>
            </div>
            
            <div class="mt-3">
                <button class="btn btn-primary rounded-pill w-100">Ingresar</button>
            </div>
        </form>
    </div>

    <%- include('includes/footer') %>
    <script>
        document.getElementById("form").addEventListener('submit', (e) => {
            e.preventDefault()
            getData()
        })
    </script>
</body>

</html>